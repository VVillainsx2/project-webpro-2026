<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ครัว - โต๊ะ <%= table.table_number %></title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 16px;
            color: #1e293b;
        }
        /* แท็บด้านข้างชุดเดียวกับหน้าครัว */
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            width: 180px;
            background-color: #1e293b;
            padding-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .sidebar a {
            color: #ffffff;
            text-decoration: none;
            padding: 14px 16px;
            min-height: 48px;
            font-size: 1.1rem;
            font-weight: bold;
        }
        .sidebar a.active { background-color: #16a34a; }
        .kitchen-container { max-width: 800px; margin: 0 auto 0 200px; }
        @media (max-width: 700px) {
            .sidebar { position: static; width: auto; flex-direction: row; padding: 8px; }
            .sidebar a { flex: 1; text-align: center; font-size: 1rem; padding: 12px 4px; }
            .kitchen-container { margin-left: auto; }
        }
        .kitchen-header { text-align: center; margin-bottom: 16px; }
        .kitchen-header h1 { margin: 0 0 12px 0; font-size: 1.8rem; }
        .back-link {
            display: inline-block;
            min-height: 48px;
            line-height: 48px;
            padding: 0 20px;
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            color: #334155;
            font-size: 1.1rem;
            font-weight: bold;
        }
        .alert {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #991b1b;
            background-color: #fee2e2;
            border: 2px solid #ef4444;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
        }
        #offline {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #92400e;
            background-color: #fef3c7;
            border: 2px solid #f59e0b;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
        }
        .section-title { font-size: 1.3rem; font-weight: bold; margin: 20px 0 12px 0; }
        .dish-card {
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .dish-card.ready { opacity: 0.85; }
        .dish-card.cancelled { opacity: 0.7; background-color: #f1f5f9; }
        .dish-card.served { opacity: 0.7; background-color: #f0fdf4; }
        .badge-served {
            display: inline-block;
            font-size: 0.95rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #0284c7;
            border-radius: 20px;
            padding: 4px 12px;
            margin-left: 8px;
        }
        .dish-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
        .dish-info { font-size: 1.2rem; }
        .dish-time { font-size: 0.95rem; color: #64748b; }
        .dish-note {
            display: block;
            color: #dc2626;
            font-style: italic;
            font-size: 1rem;
            word-break: break-word;
            margin-top: 4px;
        }
        .cancel-note {
            display: block;
            color: #991b1b;
            font-weight: bold;
            font-size: 1rem;
            word-break: break-word;
            margin-top: 4px;
        }
        .badge-wait {
            display: inline-block;
            font-size: 0.95rem;
            font-weight: bold;
            color: #166534;
            background-color: #dcfce7;
            border-radius: 20px;
            padding: 4px 12px;
            margin-left: 8px;
        }
        .wait { font-size: 0.95rem; color: #64748b; }
        .wait-over { color: #dc2626; font-weight: bold; }
        .dish-actions { display: flex; flex-direction: column; gap: 8px; }
        .btn-accept {
            min-height: 48px;
            min-width: 120px;
            padding: 0 20px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-accept:disabled { background-color: #94a3b8; cursor: default; }
        .btn-done {
            min-height: 48px;
            min-width: 120px;
            padding: 0 20px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-done:disabled { background-color: #94a3b8; cursor: default; }
        .btn-serve {
            min-height: 48px;
            min-width: 120px;
            padding: 0 20px;
            font-size: 1.1rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #0284c7;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-serve:disabled { background-color: #94a3b8; cursor: default; }
        .btn-back-step {
            min-height: 48px;
            padding: 0 16px;
            font-size: 1rem;
            font-weight: bold;
            color: #334155;
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-back-step:disabled { background-color: #94a3b8; cursor: default; }
        .btn-cancel {
            min-height: 48px;
            padding: 0 16px;
            font-size: 1rem;
            font-weight: bold;
            color: #991b1b;
            background-color: #ffffff;
            border: 2px solid #ef4444;
            border-radius: 10px;
            cursor: pointer;
            white-space: nowrap;
        }
        .btn-cancel:disabled { background-color: #94a3b8; cursor: default; }
        .empty-state {
            text-align: center;
            color: #64748b;
            font-size: 1.15rem;
            padding: 32px 16px;
            background-color: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
            margin-bottom: 12px;
        }
    </style>
</head>
<body>
<nav class="sidebar">
    <a href="/kitchen" class="<%= page === 'kitchen' ? 'active' : '' %>">ครัว</a>
    <a href="/kitchen/ordered" class="<%= page === 'ordered' ? 'active' : '' %>">ออเดอร์ที่ต้องทำ</a>
    <a href="/kitchen/status" class="<%= page === 'status' ? 'active' : '' %>">อัพเดทสถานะ</a>
</nav>
<div class="kitchen-container">
    <header class="kitchen-header">
        <h1>โต๊ะ <%= table.table_number %></h1>
        <a class="back-link" href="/kitchen">‹ กลับหน้าครัว</a>
    </header>

    <div id="offline" hidden>ขาดการเชื่อมต่อ กำลังลองใหม่...</div>
    <main id="content">
        <% if (msg === 'invalid') { %>
            <div class="alert">ข้อมูลไม่ถูกต้อง</div>
        <% } else if (msg === 'changed') { %>
            <div class="alert">สถานะรายการเปลี่ยนไปแล้ว</div>
        <% } %>

        <div class="section-title">รอรับ (<%= ordered.length %>)</div>
        <% if (ordered.length > 0) { %>
            <% ordered.forEach(function(item) { %>
                <section class="dish-card">
                    <div class="dish-row">
                        <div class="dish-info">
                            <span><%= item.qty %>× <%= item.name %></span>
                            <span class="dish-time"><%= item.timeTh %> น.</span>
                            <% if (item.note) { %>
                                <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                            <% } %>
                        </div>
                        <div class="dish-actions">
                            <form method="POST" action="/kitchen/accept" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="ids" value="<%= item.order_item_id %>">
                                <button type="submit" class="btn-accept">รับรายการอาหาร</button>
                            </form>
                        </div>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ไม่มีรายการรอรับ</div>
        <% } %>

        <div class="section-title">กำลังปรุง (<%= cooking.length %>)</div>
        <% if (cooking.length > 0) { %>
            <% cooking.forEach(function(item) { %>
                <section class="dish-card">
                    <div class="dish-row">
                        <div class="dish-info">
                            <span><%= item.qty %>× <%= item.name %></span>
                            <span class="dish-time"><%= item.timeTh %> น.</span>
                            <span class="wait<%= item.waitMin > 10 ? ' wait-over' : '' %>">(รอ <%= item.waitMin %> นาที)</span>
                            <% if (item.note) { %>
                                <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                            <% } %>
                        </div>
                        <div class="dish-actions">
                            <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="to" value="ready">
                                <input type="hidden" name="table_id" value="<%= table.table_id %>">
                                <button type="submit" class="btn-done">ปรุงเสร็จ</button>
                            </form>
                            <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="return askReason(this);">
                                <input type="hidden" name="to" value="cancelled">
                                <input type="hidden" name="table_id" value="<%= table.table_id %>">
                                <input type="hidden" name="reason" value="">
                                <button type="submit" class="btn-cancel">ยกเลิก</button>
                            </form>
                        </div>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ไม่มีรายการกำลังปรุง</div>
        <% } %>

        <div class="section-title">พร้อมเสิร์ฟ (<%= ready.length %>)</div>
        <% if (ready.length > 0) { %>
            <% ready.forEach(function(item) { %>
                <section class="dish-card ready">
                    <div class="dish-row">
                        <div class="dish-info">
                            <span><%= item.qty %>× <%= item.name %></span>
                            <span class="badge-wait">รอเสิร์ฟ</span>
                            <span class="wait<%= item.waitMin > 10 ? ' wait-over' : '' %>">(รอ <%= item.waitMin %> นาที)</span>
                            <% if (item.note) { %>
                                <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                            <% } %>
                        </div>
                        <div class="dish-actions">
                            <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="to" value="served">
                                <input type="hidden" name="table_id" value="<%= table.table_id %>">
                                <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                            </form>
                            <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="to" value="cooking">
                                <input type="hidden" name="table_id" value="<%= table.table_id %>">
                                <button type="submit" class="btn-back-step">ย้อนกลับ</button>
                            </form>
                            <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="return askReason(this);">
                                <input type="hidden" name="to" value="cancelled">
                                <input type="hidden" name="table_id" value="<%= table.table_id %>">
                                <input type="hidden" name="reason" value="">
                                <button type="submit" class="btn-cancel">ยกเลิก</button>
                            </form>
                        </div>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ยังไม่มีรายการพร้อมเสิร์ฟ</div>
        <% } %>

        <div class="section-title">เสิร์ฟแล้ว (<%= served.length %>)</div>
        <% if (served.length > 0) { %>
            <% served.forEach(function(item) { %>
                <section class="dish-card served">
                    <div class="dish-row">
                        <div class="dish-info">
                            <span><%= item.qty %>× <%= item.name %></span>
                            <span class="badge-served">เสิร์ฟแล้ว</span>
                            <% if (item.note) { %>
                                <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                            <% } %>
                        </div>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ยังไม่มีรายการที่เสิร์ฟ</div>
        <% } %>

        <div class="section-title">ยกเลิกแล้ว (<%= cancelled.length %>)</div>
        <% if (cancelled.length > 0) { %>
            <% cancelled.forEach(function(item) { %>
                <section class="dish-card cancelled">
                    <div class="dish-row">
                        <div class="dish-info">
                            <span><%= item.qty %>× <%= item.name %></span>
                            <span class="cancel-note">ยกเลิกแล้ว: <%= item.cancel_reason %></span>
                            <% if (item.note) { %>
                                <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                            <% } %>
                        </div>
                    </div>
                </section>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ไม่มีรายการที่ยกเลิก</div>
        <% } %>
    </main>
</div>
<script>
    // ถามเหตุผลยกเลิกก่อนส่งฟอร์ม (ไม่พิมพ์ = ไม่ส่ง)
    function askReason(f) {
        const r = prompt('เหตุผลที่ยกเลิก:');
        if (!r || !r.trim()) return false;
        f.reason.value = r.trim();
        const b = f.querySelector('[type=submit]');
        if (b) b.disabled = true;
        return true;
    }
    (function () {
        const p = new URLSearchParams(location.search);
        if (p.has('msg')) {
            p.delete('msg');
            const q = p.toString();
            history.replaceState(null, '', location.pathname + (q ? '?' + q : ''));
        }
    })();
    setInterval(async () => {
        try {
            const res = await fetch(location.href, { cache: 'no-store' });
            if (!res.ok) throw new Error('bad status');
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            document.getElementById('content').innerHTML = doc.getElementById('content').innerHTML;
            document.getElementById('offline').hidden = true;
        } catch (e) {
            document.getElementById('offline').hidden = false;
        }
    }, 4000);
</script>
</body>
</html>
