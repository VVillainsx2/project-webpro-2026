<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ครัว - รายการอาหาร</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 16px;
            color: #1e293b;
        }
        .kitchen-container { max-width: 1200px; margin: 0 auto; }
        .kitchen-header { text-align: center; margin-bottom: 16px; }
        .kitchen-header h1 { margin: 0 0 12px 0; font-size: 1.8rem; }
        .tab-bar { display: flex; gap: 12px; justify-content: center; margin-bottom: 20px; }
        .tab-bar a {
            flex: 1;
            max-width: 320px;
            text-align: center;
            padding: 14px 10px;
            min-height: 48px;
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            text-decoration: none;
            color: #334155;
            font-size: 1.1rem;
            font-weight: bold;
        }
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }
        @media (max-width: 600px) {
            .card-grid { grid-template-columns: 1fr; }
        }
        .order-card {
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }
        .table-name { font-size: 1.4rem; font-weight: bold; color: #334155; }
        .order-time { font-size: 0.95rem; color: #64748b; }
        .dish { padding: 6px 0; font-size: 1.15rem; }
        .dish-note {
            display: block;
            color: #dc2626;
            font-style: italic;
            font-size: 1rem;
            word-break: break-word;
        }
        .btn-accept {
            width: 100%;
            margin-top: 12px;
            min-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }
        .btn-accept:disabled { background-color: #94a3b8; cursor: default; }
        .empty-state {
            text-align: center;
            color: #64748b;
            font-size: 1.2rem;
            padding: 48px 16px;
            background-color: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
        }
    </style>
</head>
<body>
<div class="kitchen-container">
    <header class="kitchen-header">
        <h1>ครัว - รายการอาหาร</h1>
    </header>

    <nav class="tab-bar">
        <a href="/kitchen?tab=new">ออเดอร์ใหม่</a>
        <a href="/kitchen?tab=accepted">งานที่รับแล้ว</a>
    </nav>

    <main id="content">
        <% if (tables && tables.length > 0) { %>
            <div class="card-grid">
                <% tables.forEach(function(t) { %>
                    <section class="order-card">
                        <div class="card-head">
                            <span class="table-name">โต๊ะ <%= t.table_number %></span>
                            <span class="order-time"><%= t.firstTimeTh %> น.</span>
                        </div>
                        <% t.items.forEach(function(item) { %>
                            <div class="dish">
                                <span><%= item.qty %>× <%= item.name %></span>
                                <% if (item.note) { %>
                                    <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                                <% } %>
                            </div>
                        <% }); %>
                        <% if (tab === 'new') { %>
                            <form method="POST" action="/kitchen/accept" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="ids" value="<%= t.ids %>">
                                <button type="submit" class="btn-accept">รับรายการอาหาร</button>
                            </form>
                        <% } %>
                    </section>
                <% }); %>
            </div>
        <% } else { %>
            <% if (tab === 'new') { %>
                <div class="empty-state">ไม่มีออเดอร์ใหม่</div>
            <% } else { %>
                <div class="empty-state">ไม่มีงานที่รับแล้ว</div>
            <% } %>
        <% } %>
    </main>
</div>
</body>
</html>
