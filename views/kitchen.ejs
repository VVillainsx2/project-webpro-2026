<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            margin: 0;
            padding: 16px;
            color: #1e293b;
        }
        .kitchen-container { max-width: 1200px; margin: 0 auto; }
        .kitchen-header { text-align: center; margin-bottom: 16px; }
        .kitchen-header h1 { margin: 0 0 12px 0; font-size: 1.8rem; }
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }
        @media (max-width: 600px) {
            .card-grid { grid-template-columns: 1fr; }
        }
        .order-card {
            background-color: #ffffff;
            border: 2px solid #e2e8f0;
            border-radius: 12px;
            padding: 16px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .card-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 8px;
            margin-bottom: 8px;
        }
        .table-name { font-size: 1.4rem; font-weight: bold; color: #334155; }
        .order-time { font-size: 0.95rem; color: #64748b; }
        .dish { padding: 6px 0; font-size: 1.15rem; }
        .dish-row-line { display: flex; justify-content: space-between; gap: 8px; }
        .bill-total {
            display: flex;
            justify-content: space-between;
            border-top: 1px solid #e2e8f0;
            margin-top: 8px;
            padding-top: 8px;
            font-size: 1.2rem;
            font-weight: bold;
            color: #334155;
        }
        .dish-note {
            display: block;
            color: #dc2626;
            font-style: italic;
            font-size: 1rem;
            word-break: break-word;
        }
        .btn-accept {
            width: 100%;
            margin-top: 12px;
            min-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }
        .btn-accept:disabled { background-color: #94a3b8; cursor: default; }
        .btn-link {
            display: block;
            text-align: center;
            margin-top: 12px;
            min-height: 48px;
            line-height: 48px;
            font-size: 1.15rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #2563eb;
            border-radius: 10px;
            text-decoration: none;
        }
        .alert {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #991b1b;
            background-color: #fee2e2;
            border: 2px solid #ef4444;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
        }
        #offline {
            text-align: center;
            font-size: 1.1rem;
            font-weight: bold;
            color: #92400e;
            background-color: #fef3c7;
            border: 2px solid #f59e0b;
            border-radius: 12px;
            padding: 12px;
            margin-bottom: 16px;
        }
        .badge-new {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #ef4444;
            border-radius: 20px;
            padding: 4px 12px;
            margin-left: 8px;
        }
        .badge-cooking {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #f59e0b;
            border-radius: 20px;
            padding: 4px 12px;
            margin-left: 8px;
        }
        .badge-ready {
            display: inline-block;
            font-size: 0.9rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #16a34a;
            border-radius: 20px;
            padding: 4px 12px;
            margin-left: 8px;
        }
        .btn-serve {
            width: 100%;
            margin-top: 8px;
            min-height: 48px;
            font-size: 1.05rem;
            font-weight: bold;
            color: #ffffff;
            background-color: #0284c7;
            border: none;
            border-radius: 10px;
            cursor: pointer;
        }
        .btn-serve:disabled { background-color: #94a3b8; cursor: default; }
        .wait { font-size: 0.95rem; color: #64748b; }
        .wait-over { color: #dc2626; font-weight: bold; }
        .empty-state {
            text-align: center;
            color: #64748b;
            font-size: 1.2rem;
            padding: 48px 16px;
            background-color: #ffffff;
            border: 2px dashed #cbd5e1;
            border-radius: 12px;
        }
    </style>
</head>
<body>
<div class="kitchen-container">
    <header class="kitchen-header">
        <h1><%= title %></h1>
    </header>

    <div id="offline" hidden>ขาดการเชื่อมต่อ กำลังลองใหม่...</div>
    <main id="content">
        <% const isServer = (typeof mode !== 'undefined' && mode === 'server'); %>
        <% if (msg === 'taken') { %>
            <div class="alert">มีคนรับรายการนี้ไปแล้ว</div>
        <% } else if (msg === 'invalid') { %>
            <div class="alert">ข้อมูลไม่ถูกต้อง</div>
        <% } else if (msg === 'changed') { %>
            <div class="alert">สถานะรายการเปลี่ยนไปแล้ว</div>
        <% } %>
        <% if (bills && bills.length > 0) { %>
            <div class="card-grid">
                <% bills.forEach(function(b) { %>
                    <section class="order-card">
                        <div class="card-head">
                            <span class="table-name">โต๊ะ <%= b.table_number %><% if (b.hasNew) { %><span class="badge-new">ใหม่</span><% } %><% if (b.action === 'update') { %><span class="badge-cooking">กำลังปรุง</span><% } %><% if (b.action === 'serve') { %><span class="badge-ready">พร้อมเสิร์ฟ</span><% } %></span>
                            <span class="order-time">#<%= b.order_id %> · <%= b.firstTimeTh %> น. <span class="wait<%= b.maxWait > 10 ? ' wait-over' : '' %>">(รอ <%= b.maxWait %> นาที)</span></span>
                        </div>
                        <% b.items.forEach(function(item) { %>
                            <div class="dish">
                                <div class="dish-row-line">
                                    <span><%= item.qty %>× <%= item.name %></span>
                                    <span><%= item.lineTotal.toLocaleString() %></span>
                                </div>
                                <% if (item.note) { %>
                                    <span class="dish-note">หมายเหตุ: <%= item.note %></span>
                                <% } %>
                                <% if (isServer && b.action === 'serve') { %>
                                    <form method="POST" action="/kitchen/item/<%= item.order_item_id %>/status" onsubmit="var x=this.querySelector('[type=submit]');if(x)x.disabled=true;">
                                        <input type="hidden" name="to" value="served">
                                        <input type="hidden" name="table_id" value="<%= b.table_id %>">
                                        <input type="hidden" name="back" value="/orders">
                                        <button type="submit" class="btn-serve">เสิร์ฟแล้ว</button>
                                    </form>
                                <% } %>
                            </div>
                        <% }); %>
                        <div class="bill-total"><span>รวม</span><span>฿<%= b.total.toLocaleString() %></span></div>
                        <% if (!isServer && b.action === 'accept') { %>
                            <form method="POST" action="/kitchen/accept" onsubmit="var b=this.querySelector('[type=submit]');if(b)b.disabled=true;">
                                <input type="hidden" name="ids" value="<%= b.ids %>">
                                <button type="submit" class="btn-accept">รับรายการอาหาร</button>
                            </form>
                        <% } %>
                        <% if (!isServer && b.action === 'update') { %>
                            <a class="btn-link" href="/kitchen/table/<%= b.table_id %>">อัพเดทสถานะ</a>
                        <% } %>
                        <% if (isServer) { %>
                            <a class="btn-link" href="/kitchen/table/<%= b.table_id %>">ดูรายละเอียด</a>
                        <% } %>
                    </section>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-state">ไม่มีออเดอร์ใหม่</div>
        <% } %>
    </main>
</div>
<script>
    (function () {
        const p = new URLSearchParams(location.search);
        if (p.has('msg')) {
            p.delete('msg');
            const q = p.toString();
            history.replaceState(null, '', location.pathname + (q ? '?' + q : ''));
        }
    })();
    setInterval(async () => {
        try {
            const res = await fetch(location.href, { cache: 'no-store' });
            if (!res.ok) throw new Error('bad status');
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            document.getElementById('content').innerHTML = doc.getElementById('content').innerHTML;
            document.getElementById('offline').hidden = true;
        } catch (e) {
            document.getElementById('offline').hidden = false;
        }
    }, 4000);
</script>
</body>
</html>
